rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Roles live in users/{uid} = { role: "admin" | "recorder" }. Edit them in the Firebase console.
    function role() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : null;
    }
    function isStaff() { return request.auth != null && role() in ['admin', 'recorder']; }
    function isAdmin() { return request.auth != null && role() == 'admin'; }

    // Nobody can write from the browser. All writes go through server routes (Admin SDK bypasses these rules).
    match /users/{uid}       { allow read: if request.auth != null && request.auth.uid == uid; allow write: if false; }
    match /members/{id}      { allow read: if isStaff(); allow write: if false; }
    match /tithes/{id}       { allow read: if isStaff(); allow write: if false; }
    match /smsTemplates/{id} { allow read: if isAdmin(); allow write: if false; }
    match /smsLogs/{id}      { allow read: if isAdmin(); allow write: if false; }
    match /settings/{id}     { allow read: if isStaff(); allow write: if false; }
    match /auditLogs/{id}    { allow read: if isAdmin(); allow write: if false; }

    match /{document=**} { allow read, write: if false; }
  }
}
