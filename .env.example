# --- Firebase client (public, safe in browser) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Set to "true" to use the local Firebase Emulator Suite
NEXT_PUBLIC_USE_EMULATORS=false

# --- Firebase Admin (server only; never expose) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the \n escapes; wrap in double quotes
FIREBASE_PRIVATE_KEY=

# --- mNotify SMS (server only) ---
MNOTIFY_API_KEY=
# Registered sender ID, max 11 characters
MNOTIFY_SENDER_ID=
MNOTIFY_BASE_URL=https://api.mnotify.com/api
# Warn on dashboard when SMS balance drops below this
SMS_LOW_BALANCE_THRESHOLD=50

# --- App ---
NEXT_PUBLIC_IDLE_TIMEOUT_MINUTES=30

# --- Local emulators (optional; see README) ---
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
